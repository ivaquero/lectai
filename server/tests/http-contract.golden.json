  {
   "label": "stack/ops",
   "method": "GET",
   "url": "/api/stack/ops",
   "status": 200,
   "contentType": "application/json",
   "body": {
    "code": 0,
    "msg": "ok",
    "data": {
     "module": "stack",
     "max_nodes": 10,
     "ops": [
      {
       "key": "build",
       "title": "建栈（逐个入栈）",
       "lines": [
        "S.top = -1;                               // 空栈",
        "for each x in 输入序列:",
        "    if (S.top == MaxSize - 1) return ERROR;",
        "    S.data[++S.top] = x;                  // 指针先加一再写入"
       ],
       "structural": [
        0
       ]
      },
      {
       "key": "peek",
       "title": "读栈顶 peek",
       "lines": [
        "if (S.top == -1) return ERROR;            // 栈空",
        "return S.data[S.top];                     // 只读，top 不动"
       ],
       "structural": []
      },
      {
       "key": "pop",
       "title": "出栈 pop",
       "lines": [
        "if (S.top == -1) return ERROR;            // 栈空，无法出栈",
        "x = S.data[S.top];                        // ① 先取栈顶元素",
        "S.top--;                                  // ② 指针再下移",
        "return x;"
       ],
       "structural": []
      },
      {
       "key": "push",
       "title": "入栈 push",
       "lines": [
        "if (S.top == MaxSize - 1) return ERROR;   // 栈满，无法入栈",
        "S.top++;                                  // ① 栈顶指针先上移",
        "S.data[S.top] = x;                        // ② 再写入元素",
        "return OK;"
       ],
       "structural": []
      },
      {
       "key": "traverse",
       "title": "遍历（自栈顶向下）",
       "lines": [
        "for (i = S.top; i >= 0; i--)",
        "    visit(S.data[i]);                     // 从栈顶往栈底"
       ],
       "structural": []
      }
     ]
    }
   },
   "location": ""
  },
  {
   "label": "queue/ops",
   "method": "GET",
   "url": "/api/queue/ops",
   "status": 200,
   "contentType": "application/json",
   "body": {
    "code": 0,
    "msg": "ok",
    "data": {
     "module": "queue",
     "max_nodes": 9,
     "ops": [
      {
       "key": "build",
       "title": "建队（逐个入队）",
       "lines": [
        "Q.front = Q.rear = 0;                     // 空队",
        "for each x in 输入序列:",
        "    Q.data[Q.rear] = x;",
        "    Q.rear = (Q.rear + 1) % MaxSize;      // 取模成环"
       ],
       "structural": [
        0
       ]
      },
      {
       "key": "dequeue",
       "title": "出队 dequeue",
       "lines": [
        "if (Q.front == Q.rear) return ERROR;       // 队空",
        "x = Q.data[Q.front];                       // ① 取队头元素",
        "Q.front = (Q.front + 1) % MaxSize;         // ② 队头指针后移",
        "return x;"
       ],
       "structural": []
      },
      {
       "key": "enqueue",
       "title": "入队 enqueue",
       "lines": [
        "if ((Q.rear + 1) % MaxSize == Q.front) return ERROR;  // 队满",
        "Q.data[Q.rear] = x;                        // ① 写入队尾位置",
        "Q.rear = (Q.rear + 1) % MaxSize;           // ② 队尾指针后移（取模）",
        "return OK;"
       ],
       "structural": []
      },
      {
       "key": "peek",
       "title": "读队头 peek",
       "lines": [
        "if (Q.front == Q.rear) return ERROR;       // 队空",
        "return Q.data[Q.front];                    // 只读，front 不动"
       ],
       "structural": []
      },
      {
       "key": "traverse",
       "title": "遍历（队头 → 队尾）",
       "lines": [
        "i = Q.front;",
        "while (i != Q.rear) { visit(Q.data[i]); i = (i + 1) % MaxSize; }"
       ],
       "structural": []
      }
     ]
    }
   },
   "location": ""
  },
