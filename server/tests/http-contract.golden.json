   "label": "list/ops",
   "method": "GET",
   "url": "/api/linkedlist/ops",
   "status": 200,
   "contentType": "application/json",
   "body": {
    "code": 0,
    "msg": "ok",
    "data": {
     "module": "linkedlist",
     "max_nodes": 12,
     "ops": [
      {
       "key": "build",
       "title": "尾插法建表",
       "lines": [
        "head = NULL;",
        "s = malloc(...); s->data = x; s->next = NULL;",
        "tail->next = s;   // 空表时: head = s",
        "tail = s;"
       ],
       "structural": [
        0
       ]
      },
      {
       "key": "delete-pos",
       "title": "按位序删除",
       "lines": [
        "if (pos < 1 || pos > n) error;",
        "if (pos == 1) { q = head; head = head->next; free(q); return; }",
        "p = head;",
        "for (i = 1; i < pos - 1; i++) p = p->next;   // 走到前驱",
        "q = p->next;",
        "p->next = q->next;      // 摘链：先接后，再释放",
        "free(q);"
       ],
       "structural": []
      },
      {
       "key": "delete-value",
       "title": "按值删除",
       "lines": [
        "prev = NULL;  p = head;",
        "while (p != NULL && p->data != x) {",
        "    prev = p;  p = p->next;",
        "}",
        "if (p == NULL) return NOT_FOUND;",
        "if (prev == NULL) head = p->next;",
        "else prev->next = p->next;",
        "free(p);"
       ],
       "structural": []
      },
      {
       "key": "insert-head",
       "title": "头插法插入",
       "lines": [
        "s = (Node *)malloc(sizeof(Node));",
        "s->data = x;",
        "s->next = head;",
        "head = s;"
       ],
       "structural": []
      },
      {
       "key": "insert-tail",
       "title": "尾插法插入",
       "lines": [
        "s = (Node *)malloc(sizeof(Node));",
        "s->data = x;  s->next = NULL;",
        "if (head == NULL) { head = s; return; }",
        "p = head;",
        "while (p->next != NULL) p = p->next;",
        "p->next = s;"
       ],
       "structural": []
      },
      {
       "key": "search",
       "title": "按值查找",
       "lines": [
        "p = head;  pos = 1;",
        "while (p != NULL) {",
        "    if (p->data == x) return pos;",
        "    p = p->next;  pos++;",
        "}",
        "return -1;   // 未找到"
       ],
       "structural": []
      },
      {
       "key": "traverse",
       "title": "遍历链表",
       "lines": [
        "p = head;",
        "while (p != NULL) {",
        "    visit(p->data);",
        "    p = p->next;",
        "}"
       ],
       "structural": []
      }
     ]
    }
   },
   "location": ""
